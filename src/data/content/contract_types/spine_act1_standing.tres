[gd_resource type="Resource" script_class="ContractType" load_steps=2 format=3]

; Act I close — Reach standing beat; sets ACT1_DONE → Act II.
[ext_resource type="Script" path="res://src/data/shapes/ContractType.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"spine_act1_standing"
display_name = "Authority seal — Yard to Port priority"
offering_entity_id = &"entity_reach_authority"
kind = &"delivery"
standing_complete = 12.0
standing_fail = -4.0
standing_abandon = -10.0
pay_credits = 180
destination_station_id = &"station_alpha_port"
is_spine = true
spine_act = 1
requires_flags = PackedStringArray("flag_debt_lesson")
sets_flags = PackedStringArray("flag_standing_lesson", "flag_act1_done")
min_entity_standing = -100.0
requires_debt = false
offer_station_id = &"station_alpha_yard"
journal_blurb = "Reach Authority is watching who finishes work and who ghosts the board. This seal run from Alpha Yard back to Port is priority — higher standing on complete. Entities remember. Hostile docks refuse you; friendly ones open Services you have not seen yet. Close the loop. After this, the sector offers lanes instead of lessons."
sort_index = 50
