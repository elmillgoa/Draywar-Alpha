[gd_resource type="Resource" script_class="RecoveryChain" load_steps=7 format=3]

; S4 — Free Haulers recovery foothold. Grease Wren (low rank) offers deniable
; work so a player hated by Free Haulers can climb back.
; Same law as Mendi/Jax: Friendly personal required; deniable first step;
; StandingService only. Rank influence: low-rank → tiny Entity deltas.

[ext_resource type="Script" path="res://src/data/shapes/RecoveryChain.gd" id="1"]
[ext_resource type="Script" path="res://src/data/shapes/RecoveryStep.gd" id="2"]

