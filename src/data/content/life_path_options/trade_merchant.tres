[gd_resource type="Resource" script_class="LifePathOption" load_steps=5 format=3]

; E4.1 — Trade: Merchant marine (default). Free Haulers + Mate Dace.
[ext_resource type="Script" path="res://src/data/shapes/LifePathOption.gd" id="1"]
[ext_resource type="Script" path="res://src/data/shapes/LifePathStandingDelta.gd" id="2"]

[sub_resource type="Resource" id="delta_haulers"]
script = ExtResource("2")
target_id = &"entity_free_haulers"
delta = 15.0

[sub_resource type="Resource" id="delta_dace"]
script = ExtResource("2")
target_id = &"person_fh_dace"
delta = 10.0

[resource]
script = ExtResource("1")
id = &"trade_merchant"
display_name = "Merchant marine"
blurb = "Legitimate freight, thin margins. Free Haulers and Mate Dace already have your number."
axis = &"trade"
entity_deltas = Array[ExtResource("2")]([SubResource("delta_haulers")])
person_deltas = Array[ExtResource("2")]([SubResource("delta_dace")])
starts_with_debt = false
